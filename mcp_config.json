{
  "mcpServers": {
    "backupdr_mcp": {
      "command": "python",
      "args": ["mcp_servers/backupdr_mcp.py"],
      "env": {
        "GCP_PROJECT_ID": "${GCP_PROJECT_ID}",
        "GCP_REGION": "${GCP_REGION}"
      }
    },
    "pricing_mcp": {
      "command": "python",
      "args": ["mcp_servers/pricing_mcp.py"]
    },
    "chat_mcp": {
      "command": "python",
      "args": ["mcp_servers/chat_mcp.py"],
      "env": {
        "WEBHOOK_URL": "${WEBHOOK_URL}"
      }
    }
  }
}
